# Data (supplied separately, never committed)
data/raw/*/*
!data/raw/*/.gitkeep
data/manifest/*
!data/manifest/.gitkeep
data/captions/*
!data/captions/.gitkeep
data/eval_prompts.json

# Outputs (runs, checkpoints, generations, ratings db, cost ledger, plots)
outputs/**
!outputs/.gitkeep

# Secrets
.env
*.env

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
build/
dist/

# OS / editor
.DS_Store
.vscode/
.idea/
